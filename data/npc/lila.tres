friend_lines = PackedStringArray("{greet}, teman! Kapan-kapan kubuatkan sup spesialku untukmu.")
bio = "Aku Lila, juru masak keliling. Aku belajar resep dari berbagai penjuru negeri.|Impianku membuka kedai kecil di desa ini."
like_reply = "Persis bahan yang kucari! Terima kasih!"
neutral_reply = "Wah, terima kasih. Akan kucari resep yang cocok."
dislike_reply = "Eh... aku tidak begitu suka ini. Tapi terima kasih sudah berpikir tentangku."
favorite_items = PackedStringArray("tomato", "carrot", "croissant")
disliked_items = PackedStringArray("wood", "egg")
