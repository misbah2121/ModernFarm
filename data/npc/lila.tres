home = Vector2(340, 300)
wander_radius = 56.0
greetings = PackedStringArray("{greet}! Aku sedang cari bahan untuk sup hari ini. Tomat dan wortel, kalau ada.|Sayuran segar itu rahasia masakan enak!", "Kamu sudah coba menanam bawang? Wanginya bikin lapar.", "Aku suka berjalan di dekat sumur. Anginnya segar.")
